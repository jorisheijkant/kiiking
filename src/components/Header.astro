---
import { SITE_TITLE } from '../consts';
import { useTranslations, getLocalePath, type Lang } from '../i18n/ui';
import HeaderLink from './HeaderLink.astro';
import LanguagePicker from './LanguagePicker.astro';

const lang = (Astro.currentLocale ?? 'en') as Lang;
const t = useTranslations(lang);
const prefix = lang === 'et' ? '' : `/${lang}`;
---

<header>
	<nav>
		<h2><a href={`${prefix}/`}>{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href={`${prefix}/`}>{t('nav.home')}</HeaderLink>
			<HeaderLink href={`${prefix}/contact`}>{t('nav.contact')}</HeaderLink>
		</div>
		<div class="right">
			<LanguagePicker />
			<div class="social-links">
				<a href="https://www.facebook.com/kiiking" target="_blank">
					<span class="sr-only">{t('nav.facebook')}</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
						><path
							fill="currentColor"
							d="M16 8.049c0-4.446-3.582-8.05-8-8.05C3.58 0-.002 3.603-.002 8.05c0 4.017 2.926 7.347 6.75 7.951v-5.625h-2.03V8.05H6.75V6.275c0-2.017 1.195-3.131 3.022-3.131.876 0 1.791.157 1.791.157v1.98h-1.009c-.993 0-1.303.621-1.303 1.258v1.51h2.218l-.354 2.326H9.25V16c3.824-.604 6.75-3.934 6.75-7.951z"
						></path></svg
					>
				</a>
			</div>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.right {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
